# Example of /opt/apps/saanapp/.env on the server (never committed). Generate secrets with:
#   openssl rand -hex 32   # DJANGO_SECRET_KEY
#   openssl rand -hex 16   # DATABASE_PASSWORD

Environment=PROD
SERVICE_NAME=saanapp_core
DJANGO_SECRET_KEY=__CHANGE_ME__

DJANGO_ALLOWED_HOSTS=webapi.saanapp.ir,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://panel.saanapp.ir,https://web.saanapp.ir,https://webapi.saanapp.ir
DJANGO_CORS_ALLOWED_ORIGINS=https://panel.saanapp.ir,https://web.saanapp.ir

DATABASE_ENGINE=postgresql_psycopg2
DATABASE_NAME=saanapp
DATABASE_USERNAME=saanapp
DATABASE_PASSWORD=__CHANGE_ME__
DATABASE_HOST=db
DATABASE_PORT=5432

# Uploaded photos stay on a volume and are served only through short-lived signed links.
LOCAL_MEDIA_STORAGE=true
MEDIA_ROOT=/home/media
MEDIA_PUBLIC_BASE_URL=https://webapi.saanapp.ir

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Public API address baked into both frontends at build time.
VUE_APP_SAAN_APP_PATH=https://webapi.saanapp.ir

# Optional integrations; leave empty until their credentials exist (see docs/DEPLOYMENT.md).
FARAPAYAMAK_USERNAME=
FARAPAYAMAK_PASSWORD=
FARAPAYAMAK_FROM_NUMBER=
FARAPAYAMAK_LINKABLE_FROM_NUMBER=
WALLET_SIGNATURE_SECRET=
